      ]
    },
    {
      "name": "EFFECT",
      "controls": [
        { "param": "Effect",     "widget": "slider", "overlay": "menu" },
        { "param": "FX Time",    "widget": "knob" },
        { "param": "FX Balance", "widget": "fader" },
        "empty"
      ]
    }
